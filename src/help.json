{
  "title": "Bouba-Kiki",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Six stereo voices.",
        "Scan the deformed",
        "Bouba-Kiki contour",
        "to make sound."
      ]
    },
    {
      "title": "Playing it",
      "lines": [
        "Play chromatically.",
        "Velocity sets level",
        "and brightness.",
        "Pad pressure adds",
        "bite and swell.",
        "Pinch and Spikes",
        "blur the pitch on",
        "purpose; Morph and",
        "pressure do not."
      ]
    },
    {
      "title": "Shape",
      "lines": [
        "Morph: round to sharp",
        "Bulge: inflate lobes",
        "Pinch: squeeze waists",
        "Spikes: grow teeth",
        "Tilt: shear contour",
        "Wobble: moving ripples",
        "Attack and Release",
        "sit beside them."
      ]
    },
    {
      "title": "Envelope",
      "lines": [
        "One ADSR for level.",
        "Attack and Release",
        "also appear on the",
        "shape page for quick",
        "reach; Decay and",
        "Sustain live here."
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "Six factory sounds",
        "on the Shape page:",
        "jog to change.",
        "Pure Bouba is the",
        "undeformed default.",
        "Presets replace all",
        "ten controls."
      ]
    },
    {
      "title": "Pages",
      "lines": [
        "Shape first, with the",
        "presets on it, then",
        "the knob grid, then",
        "Envelope.",
        "The outline follows",
        "the newest note."
      ]
    }
  ]
}
